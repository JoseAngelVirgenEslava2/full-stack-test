generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  phoneNumber    String
  role           Role     @default(USER)
  status         Status   @default(ACTIVE)
  profilePicture String?
  address        Address?
  createdAt      DateTime @default(now())
}

type Address {
  street     String
  number     String
  city       String
  postalCode String
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
}